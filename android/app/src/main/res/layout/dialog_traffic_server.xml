<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:paddingTop="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_half">

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/til_traffic_server_url"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/traffic_server_url_hint"
      app:endIconMode="clear_text">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edit_traffic_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/til_traffic_api_key"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margin_half"
      android:hint="@string/traffic_server_key_hint"
      app:endIconMode="clear_text">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edit_traffic_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textNoSuggestions" />
  </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
