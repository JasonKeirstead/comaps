# Copy to .env and fill in. Used by docker-compose and by `npm start`.

# --- Provider -------------------------------------------------------------
# Free TomTom key: https://developer.tomtom.com/ (2,500 non-tile requests/day).
TOMTOM_API_KEY=

# --- Coverage -------------------------------------------------------------
# Comma-separated "Country@mapVersion", used for /healthz reporting and by
# `comaps-traffic refresh`. NOT a coverage list: an area is served because a client asks for it
# and an index exists for it, so leaving this empty costs you nothing but visibility.
#
# The country is the MWM name exactly as it appears in data/countries.txt; the version is the
# map series stamp of the MWM on the phone. Feature ids are only stable within one map build,
# so an index built for a different release produces a key-count mismatch and the client
# silently discards the payload.
TRAFFIC_AREAS=Belarus_Minsk Region@250628

# --- Refresh --------------------------------------------------------------
# Nothing runs on a timer. A client request for an area whose stored data is older than this
# refreshes it; an area nobody is looking at costs nothing at all.
#
# One of 300, 600, 1800, 3600 -- 5 min, 10 min, 30 min, 1 hour. 30 minutes by default; TomTom
# reports incidents, which persist for tens of minutes, so a shorter bound mostly fetches the
# same data again.
#
# Changeable on a running service, no restart: `comaps-traffic interval` shows the options and
# `comaps-traffic interval 600` picks one.
TRAFFIC_REFRESH_SECONDS=1800

# The only cap on provider spend. One refresh is one provider call, so at 1800s a single
# continuously-watched area costs 48/day.
TRAFFIC_DAILY_REQUEST_BUDGET=2000

# --- Access ---------------------------------------------------------------
# The URL the phone should use. Must end with a slash. On a LAN this is your machine's address,
# not localhost -- the phone resolves it, not the server.
TRAFFIC_PUBLIC_BASE_URL=http://192.168.1.50:8080/
TRAFFIC_SERVER_NAME=My CoMaps traffic

# Optional. Left blank, one is generated on first use and shown to you on the setup page at
# http://<this machine>:8080/ -- which is also where the pairing QR code lives. Set it only if
# you would rather choose your own.
# TRAFFIC_ADMIN_TOKEN=

# Alternatives to QR pairing:
#   TRAFFIC_API_KEY      a fixed key you type into the app by hand
#   TRAFFIC_ALLOW_ANONYMOUS=true   no key at all. Only sane on a trusted LAN; anyone who can
#                        reach the port can spend your provider quota.
# TRAFFIC_API_KEY=
TRAFFIC_ALLOW_ANONYMOUS=false

# --- Storage --------------------------------------------------------------
TRAFFIC_INDEX_DIR=/data
PORT=8080

# --- Matching (rarely needed) --------------------------------------------
# How close a segment must be to incident geometry to be coloured, and how far its orientation
# may differ from the incident's direction of travel. Widen the tolerance if one carriageway of
# a dual carriageway is being missed; narrow it if jams bleed onto the opposite side.
# TRAFFIC_MATCH_RADIUS_M=40
# TRAFFIC_BEARING_TOLERANCE_DEG=50
