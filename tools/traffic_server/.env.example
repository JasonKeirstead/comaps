# Copy to .env and fill in. Used by docker-compose and by `npm start`.

# --- Provider -------------------------------------------------------------
# Free TomTom key: https://developer.tomtom.com/ (2,500 non-tile requests/day).
TOMTOM_API_KEY=

# --- Coverage -------------------------------------------------------------
# Comma-separated "Country@mapVersion". The country is the MWM name exactly as it appears in
# data/countries.txt; the version is the map series stamp of the MWM on the phone.
#
# Feature ids are only stable within one map build, so an index built for a different release
# produces a key-count mismatch and the client silently discards the payload. When you update
# maps, rebuild the index and bump the version here.
#
# Coverage is bounded areas, not whole countries -- see the index builder's --max-segments.
TRAFFIC_AREAS=Belarus_Minsk Region@250628

# --- Refresh --------------------------------------------------------------
# One provider request per area per refresh. The client polls once a minute and treats data
# older than six minutes as outdated, so 300s is a good default.
#   requests/day = 86400 / TRAFFIC_REFRESH_SECONDS * number of areas
TRAFFIC_REFRESH_SECONDS=300
TRAFFIC_DAILY_REQUEST_BUDGET=2000

# --- Access ---------------------------------------------------------------
# The URL the phone should use. Must end with a slash. On a LAN this is your machine's address,
# not localhost -- the phone resolves it, not the server.
TRAFFIC_PUBLIC_BASE_URL=http://192.168.1.50:8080/
TRAFFIC_SERVER_NAME=My CoMaps traffic

# Needed to issue pairing codes (`comaps-traffic pair`).
TRAFFIC_ADMIN_TOKEN=

# Alternatives to QR pairing:
#   TRAFFIC_API_KEY      a fixed key you type into the app by hand
#   TRAFFIC_ALLOW_ANONYMOUS=true   no key at all. Only sane on a trusted LAN; anyone who can
#                        reach the port can spend your provider quota.
# TRAFFIC_API_KEY=
TRAFFIC_ALLOW_ANONYMOUS=false

# --- Storage --------------------------------------------------------------
TRAFFIC_INDEX_DIR=/data
PORT=8080

# --- Matching (rarely needed) --------------------------------------------
# How close a segment must be to incident geometry to be coloured, and how far its orientation
# may differ from the incident's direction of travel. Widen the tolerance if one carriageway of
# a dual carriageway is being missed; narrow it if jams bleed onto the opposite side.
# TRAFFIC_MATCH_RADIUS_M=40
# TRAFFIC_BEARING_TOLERANCE_DEG=50
