# Secrets for the Worker. The Deploy to Cloudflare flow reads this file and prompts for each
# value, so nothing belongs here that the person deploying cannot answer. From the CLI use
# `wrangler secret put <NAME>`. Never commit real values.

# The only thing you have to supply. Free key from https://developer.tomtom.com/, no card
# required (2,500 non-tile requests/day).
TOMTOM_API_KEY=

# TRAFFIC_ADMIN_TOKEN is deliberately not listed. It is generated on first use and shown to you
# on the /setup page, because asking someone to invent one before they know what it is for is
# the fastest way to make a deploy fail.
